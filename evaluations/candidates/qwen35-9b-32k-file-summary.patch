diff --git a/tests/test_file_summary.py b/tests/test_file_summary.py
new file mode 100644
--- /dev/null
+++ b/tests/test_file_summary.py
@@ -0,0 +1,144 @@
+import os
+import tempfile
+import unittest
+from pathlib import Path
+
+from autoproteus.tools import Workspace
+
+ROOT = Path(__file__).resolve().parents[1]
+TEST_TEMP = Path(os.environ.get('AUTOPROTEUS_TEST_ROOT', str(ROOT / '.data/test-tmp')))
+
+
+def temporary_directory():
+    TEST_TEMP.mkdir(parents=True, exist_ok=True)
+    directory = tempfile.TemporaryDirectory(dir=TEST_TEMP)
+    if not Path(directory.name).resolve().is_relative_to(TEST_TEMP.resolve()):
+        raise RuntimeError('Unexpected temporary directory')
+    return directory
+
+
+class FileSummaryTests(unittest.TestCase):
+    def test_empty_file_returns_zero_counts(self):
+        with temporary_directory() as directory:
+            workspace = Workspace(Path(directory))
+            workspace.execute('write_file', {'path': 'empty.txt', 'content': ''})
+            result = workspace.execute('file_summary', {'path': 'empty.txt'})
+            self.assertEqual(result['path'], 'empty.txt')
+            self.assertEqual(result['bytes'], 0)
+            self.assertEqual(result['characters'], 0)
+            self.assertEqual(result['lines'], 0)
+            self.assertEqual(result['words'], 0)
+
+    def test_simple_text_counts_correctly(self):
+        with temporary_directory() as directory:
+            workspace = Workspace(Path(directory))
+            content = 'Hello world\nThis is a test file.\n'
+            workspace.execute('write_file', {'path': 'text.txt', 'content': content})
+            result = workspace.execute('file_summary', {'path': 'text.txt'})
+            self.assertEqual(result['path'], 'text.txt')
+            self.assertEqual(result['bytes'], len(content.encode('utf-8')))
+            self.assertEqual(result['characters'], len(content))
+            self.assertEqual(result['lines'], 2)
+            self.assertEqual(result['words'], 7)
+
+    def test_multiline_text_counts_lines_and_words(self):
+        with temporary_directory() as directory:
+            workspace = Workspace(Path(directory))
+            content = 'Line one\nLine two\nLine three\n'
+            workspace.execute('write_file', {'path': 'multi.txt', 'content': content})
+            result = workspace.execute('file_summary', {'path': 'multi.txt'})
+            self.assertEqual(result['lines'], 3)
+            self.assertEqual(result['words'], 6)
+
+    def test_unicode_text_counts_characters_and_bytes_separately(self):
+        with temporary_directory() as directory:
+            workspace = Workspace(Path(directory))
+            content = 'Hello é🙂世界'
+            workspace.execute('write_file', {'path': 'unicode.txt', 'content': content})
+            result = workspace.execute('file_summary', {'path': 'unicode.txt'})
+            self.assertEqual(result['characters'], len(content))
+            self.assertEqual(result['bytes'], len(content.encode('utf-8')))
+            # 'é' is 2 bytes, '🙂' is 4 bytes, '世界' is 6 bytes
+            self.assertEqual(result['bytes'], 18)
+
+    def test_crlf_line_endings_preserved_and_counted(self):
+        with temporary_directory() as directory:
+            workspace = Workspace(Path(directory))
+            content = 'Line1\r\nLine2\r\n'
+            workspace.execute('write_file', {'path': 'crlf.txt', 'content': content})
+            result = workspace.execute('file_summary', {'path': 'crlf.txt'})
+            self.assertEqual(result['lines'], 2)
+            self.assertEqual(result['bytes'], len(content.encode('utf-8')))
+            self.assertEqual(result['characters'], len(content))
+
+    def test_mixed_line_endings_counted_correctly(self):
+        with temporary_directory() as directory:
+            workspace = Workspace(Path(directory))
+            content = 'Line1\nLine2\r\nLine3\r\nLine4\n'
+            workspace.execute('write_file', {'path': 'mixed.txt', 'content': content})
+            result = workspace.execute('file_summary', {'path': 'mixed.txt'})
+            self.assertEqual(result['lines'], 4)
+            self.assertEqual(result['bytes'], len(content.encode('utf-8')))
+
+    def test_large_file_rejected(self):
+        with temporary_directory() as directory:
+            workspace = Workspace(Path(directory))
+            # Write a file that's just at the limit
+            content = 'x' * 100000
+            workspace.execute('write_file', {'path': 'large.txt', 'content': content})
+            # Verify it works at the limit
+            result = workspace.execute('file_summary', {'path': 'large.txt'})
+            self.assertEqual(result['bytes'], 100000)
+            # Now manually extend the file beyond the limit to test rejection
+            # We need to append to the existing file
+            existing = (Path(directory) / 'large.txt').read_bytes()
+            (Path(directory) / 'large.txt').write_bytes(existing + b'x')
+            with self.assertRaises(ValueError) as context:
+                workspace.execute('file_summary', {'path': 'large.txt'})
+            self.assertIn('exceeds', str(context.exception))
+
+    def test_invalid_utf8_rejected(self):
+        with temporary_directory() as directory:
+            workspace = Workspace(Path(directory))
+            (Path(directory) / 'binary.txt').write_bytes(b'\xff\n')
+            with self.assertRaises(ValueError) as context:
+                workspace.execute('file_summary', {'path': 'binary.txt'})
+            self.assertIn('UTF-8', str(context.exception))
+
+    def test_directory_path_rejected(self):
+        with temporary_directory() as directory:
+            workspace = Workspace(Path(directory))
+            # Try to use a path that doesn't exist - should fail with a meaningful error
+            with self.assertRaises(ValueError) as context:
+                workspace.execute('file_summary', {'path': 'nonexistent.txt'})
+            # The error message should indicate the file cannot be read
+            self.assertIn('exists', str(context.exception))
+
+    def test_outside_workspace_path_rejected(self):
+        with temporary_directory() as directory:
+            workspace = Workspace(Path(directory))
+            with self.assertRaises(ValueError) as context:
+                workspace.execute('file_summary', {'path': '../outside.txt'})
+            self.assertIn('outside', str(context.exception))
+
+    def test_very_long_words_counted_correctly(self):
+        with temporary_directory() as directory:
+            workspace = Workspace(Path(directory))
+            content = 'A' * 100000
+            workspace.execute('write_file', {'path': 'longword.txt', 'content': content})
+            result = workspace.execute('file_summary', {'path': 'longword.txt'})
+            self.assertEqual(result['words'], 1)
+            self.assertEqual(result['characters'], 100000)
+
+    def test_multiple_spaces_and_tabs_counted_as_words(self):
+        with temporary_directory() as directory:
+            workspace = Workspace(Path(directory))
+            content = 'hello   world\t\ttest'
+            workspace.execute('write_file', {'path': 'spaces.txt', 'content': content})
+            result = workspace.execute('file_summary', {'path': 'spaces.txt'})
+            self.assertEqual(result['words'], 3)
+            self.assertEqual(result['characters'], len(content))
+
+
+if __name__ == '__main__':
+    unittest.main()
